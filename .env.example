# Public URL of the app, used for the Origin check
APP_BASE_URL=http://localhost:3000

# Time zone for "today", dates and schedules (set to the company's own)
APP_TIMEZONE=Europe/Athens

# SQLite file
DATABASE_PATH=./data/bot.db

# 32-byte key, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Lifetime of a web session, in days
SESSION_TTL_DAYS=30

# OpenProject instance
OPENPROJECT_BASE_URL=http://localhost:8080

# Optional: restrict candidates to these projects (sandbox during development)
OPENPROJECT_PROJECT_IDS=

# LLM provider: deepseek | anthropic | openai
LLM_PROVIDER=deepseek

# Model name for that provider
LLM_MODEL=deepseek-v4-flash

# DeepSeek API key (secret)
DEEPSEEK_API_KEY=

# Optional base URL override for the DeepSeek API
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Expiry of unconfirmed proposals, in minutes
PROPOSAL_TTL_MINUTES=10

# How long undo is allowed, in minutes
UNDO_WINDOW_MINUTES=30

# How long the bot remembers the work package you last discussed, in minutes
CONTEXT_MEMORY_MINUTES=30

# Date window for candidate work packages
CANDIDATE_DAYS_BACK=7
CANDIDATE_DAYS_AHEAD=1

# Oldest allowed spentOn for a time entry
MAX_DAYS_BACK_FOR_TIME=7

# Appended to comments written by the bot
BOT_COMMENT_SUFFIX=(via chat bot)

# pino level
LOG_LEVEL=info
